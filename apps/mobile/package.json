{
  "name": "@saraya/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "start:dev-client": "expo start --dev-client",
    "start:go": "expo start --go",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "build:android:development": "npx eas-cli@24.7.0 build --platform android --profile development",
    "build:android:preview": "npx eas-cli@24.7.0 build --platform android --profile preview",
    "build:android:production": "npx eas-cli@24.7.0 build --platform android --profile production",
    "submit:android:production": "npx eas-cli@24.7.0 submit --platform android --profile production",
    "credentials:android": "npx eas-cli@24.7.0 credentials --platform android",
    "check:android": "node scripts/validate-android-delivery.mjs",
    "doctor": "expo-doctor",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@saraya/api-client": "0.1.0",
    "@saraya/contracts": "0.1.0",
    "expo": "~57.0.25",
    "expo-calendar": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.46.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-google-signin": "^2.3.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-purchases": "^10.10.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "zod": "^4.6.5"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-google-signin"
        ]
      }
    }
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.20.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.7",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleDirectories": [
      "<rootDir>/node_modules",
      "<rootDir>/../../node_modules",
      "node_modules"
    ],
    "setupFiles": [
      "<rootDir>/src/test/setup.ts"
    ],
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/src/test/mocks/lucide.tsx",
      "^expo-modules-core(.*)$": "<rootDir>/../../node_modules/expo/node_modules/expo-modules-core$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/app/"
    ]
  }
}
