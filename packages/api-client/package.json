{
  "name": "@saraya/api-client",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@saraya/contracts": "0.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^24.3.0",
    "jest": "~29.7.0",
    "ts-jest": "^29.4.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "moduleNameMapper": {
      "^@saraya/contracts$": "<rootDir>/../contracts/src/index.ts"
    }
  }
